      "fine_tuning": "full_encoder"
    },
    "partial4": {
      "loss": "weighted_ce",
      "policy": "freeze embeddings, shared encoder backbone, and layers 0-7; train layers 8-11, pooler, and classifier",
      "trainable_last_layers": 4,
      "optimizer_membership": "trainable_parameters_only"
    }
  },
  "calibration": {
    "precision_targets": [0.2, 0.3, 0.5],
    "primary_precision_target": 0.3,
    "selection": "maximize recall subject to fitting-side precision target; ties: higher precision, then higher threshold",
    "infeasible": "explicit; no always-positive fallback",
    "outer_labels_used": false
