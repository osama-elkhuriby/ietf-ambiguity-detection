  "evaluation": {
    "primary_ranking_metric": "average_precision",
    "top_k": [10, 20, 25, 50, 100],
    "bootstrap_replicates": 2000,
    "bootstrap_cluster": "rfc_family",
    "error_primary_policy": "nested_precision_0.30",
    "selection_bias_warning": "The 100 reviewed clauses were chosen from historical OOF errors. Evaluation on those families is not an independent estimate of improvement; no unbiased generalization-improvement claim is permitted without a genuinely independent evaluation set."
  },
  "conditions": {"A2": "weighted_ce"},
  "outputs": {
