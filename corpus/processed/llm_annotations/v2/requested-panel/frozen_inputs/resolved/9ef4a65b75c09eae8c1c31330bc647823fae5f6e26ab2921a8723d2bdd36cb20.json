    {
      "block_id": "draft-ietf-quic-transport-27:13.2.4:b0550",
      "clause_id": "draft-ietf-quic-transport-27:13.2.4:b0550:c01",
      "content": "To limit ACK Ranges (see [ack-ranges]) to those that have not yet been received by the sender, the receiver SHOULD track which ACK frames have been acknowledged by its peer.",
      "content_sha256": "84a9819d7251b0275a6078690f2c375e78ea57cc0610e516f92e17a421a5e107",
