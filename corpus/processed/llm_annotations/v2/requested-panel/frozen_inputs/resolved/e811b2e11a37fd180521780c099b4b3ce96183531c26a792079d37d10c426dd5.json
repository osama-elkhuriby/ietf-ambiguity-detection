      }
    },
    {
      "block_id": "draft-ietf-httpbis-http2bis-03:2.2:b0027",
      "clause_id": "draft-ietf-httpbis-http2bis-03:2.2:b0027:c01",
      "content": "connection:: A transport-layer connection between two endpoints.",
      "content_sha256": "f1bdfc31ad87c641359a81f1105d7d18b98bbe9e90ba19ac01d40430c2312f1b",
      "document_id": "draft-ietf-httpbis-http2bis-03",
      "kind": "definition",
      "retrieval_reason": "same_revision_definition_candidate",
      "revision": "03",
      "section_heading": "Conventions and Terminology",
      "section_id": "2.2",
      "source_sha256": "a869e99e9399d9e158bdfdd551924bd7670ad9f9cc03e6a212e9b443bacad22c",
      "source_span": {
        "line_end": null,
        "line_start": null,
        "xpath": "/rfc/middle/section[2]/section[2]/dl/dd[2]"
      }
    },
    {
      "block_id": "draft-ietf-httpbis-http2bis-03:2.2:b0028",
      "clause_id": "draft-ietf-httpbis-http2bis-03:2.2:b0028:c01",
      "content": "connection error:: An error that affects the entire HTTP/2 connection.",
      "content_sha256": "fc2431d9df819d4f83d8e1f332627609b7ca57197a17a12a6062c03b27ee52f0",
      "document_id": "draft-ietf-httpbis-http2bis-03",
