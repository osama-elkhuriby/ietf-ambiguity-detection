      "revision": "03",
      "section_heading": "Conventions and Terminology",
      "section_id": "2.2",
      "source_sha256": "a869e99e9399d9e158bdfdd551924bd7670ad9f9cc03e6a212e9b443bacad22c",
      "source_span": {
        "line_end": null,
        "line_start": null,
        "xpath": "/rfc/middle/section[2]/section[2]/dl/dd[3]"
      }
    },
    {
      "block_id": "draft-ietf-httpbis-http2bis-03:2.2:b0029",
      "clause_id": "draft-ietf-httpbis-http2bis-03:2.2:b0029:c01",
      "content": "endpoint:: Either the client or server of the connection.",
      "content_sha256": "cc89d4a62d9c519bd2500ca232eafc0818253cf36d90173bd1a3cd7d48d3331d",
      "document_id": "draft-ietf-httpbis-http2bis-03",
      "kind": "definition",
      "retrieval_reason": "same_revision_definition_candidate",
      "revision": "03",
      "section_heading": "Conventions and Terminology",
      "section_id": "2.2",
      "source_sha256": "a869e99e9399d9e158bdfdd551924bd7670ad9f9cc03e6a212e9b443bacad22c",
      "source_span": {
        "line_end": null,
        "line_start": null,
        "xpath": "/rfc/middle/section[2]/section[2]/dl/dd[4]"
      }
    },
    {
      "block_id": "draft-ietf-httpbis-http2bis-03:2.2:b0030",
      "clause_id": "draft-ietf-httpbis-http2bis-03:2.2:b0030:c01",
      "content": "frame:: The smallest unit of communication within an HTTP/2 connection, consisting of a header and a variable-length sequence of octets structured according to the frame type.",
      "content_sha256": "00c17dce97c9c4567c24317484854b5b331773d296dde67b2f193377fd2107ae",
      "document_id": "draft-ietf-httpbis-http2bis-03",
      "kind": "definition",
      "retrieval_reason": "same_revision_definition_candidate",
      "revision": "03",
      "section_heading": "Conventions and Terminology",
      "section_id": "2.2",
      "source_sha256": "a869e99e9399d9e158bdfdd551924bd7670ad9f9cc03e6a212e9b443bacad22c",
      "source_span": {
        "line_end": null,
        "line_start": null,
        "xpath": "/rfc/middle/section[2]/section[2]/dl/dd[5]"
      }
    },
    {
      "block_id": "draft-ietf-httpbis-http2bis-03:2.2:b0031",
      "clause_id": "draft-ietf-httpbis-http2bis-03:2.2:b0031:c01",
      "content": "peer:: An endpoint.",
      "content_sha256": "32960b094067151f46f88e57a2a92fce9edefd9518272f02fc3f596a1750dd69",
      "document_id": "draft-ietf-httpbis-http2bis-03",
      "kind": "definition",
      "retrieval_reason": "same_revision_definition_candidate",
      "revision": "03",
      "section_heading": "Conventions and Terminology",
      "section_id": "2.2",
      "source_sha256": "a869e99e9399d9e158bdfdd551924bd7670ad9f9cc03e6a212e9b443bacad22c",
      "source_span": {
        "line_end": null,
        "line_start": null,
        "xpath": "/rfc/middle/section[2]/section[2]/dl/dd[6]"
      }
    },
    {
      "block_id": "draft-ietf-httpbis-http2bis-03:2.2:b0031",
      "clause_id": "draft-ietf-httpbis-http2bis-03:2.2:b0031:c02",
      "content": "When discussing a particular endpoint, \"peer\" refers to the endpoint that is remote to the primary subject of discussion.",
      "content_sha256": "eddcf3f0a7314d18a4bb40425da84cc436c5af94af16936758eac5101fa8e87e",
      "document_id": "draft-ietf-httpbis-http2bis-03",
      "kind": "definition",
      "retrieval_reason": "same_revision_definition_candidate",
      "revision": "03",
